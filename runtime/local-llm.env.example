# Copy with scripts/bootstrap-local-llm.sh; never edit this example in place.
QWEN_MODEL=Qwen/Qwen3.8-Flash-Next
VLLM_API_BASE=http://127.0.0.1:8000/v1
VLLM_METRICS_URL=http://127.0.0.1:8000/metrics
LITELLM_PORT=4000
LANGFUSE_PORT=3000
LITELLM_IMAGE=ghcr.io/berriai/litellm:main-stable
LANGFUSE_IMAGE=docker.langfuse.com/langfuse/langfuse:4
LANGFUSE_WORKER_IMAGE=docker.langfuse.com/langfuse/langfuse-worker:4
POSTGRES_IMAGE=postgres:16-alpine
CLICKHOUSE_IMAGE=clickhouse/clickhouse-server:25.12
REDIS_IMAGE=redis:7-alpine
MINIO_IMAGE=cgr.dev/chainguard/minio
MINIO_PORT=9090
# v4 dual-write preserves v3 reads and ingestion while project-side
# evaluators, exports, and external producers are migrated and verified.
LANGFUSE_MIGRATION_V4_WRITE_MODE=dual
LANGFUSE_MIGRATION_V4_ALLOW_PREVIEW_OPT_IN=false
LANGFUSE_BACKGROUND_MIGRATION_V4_ENABLE_HISTORIC_BACKFILL=false
LANGFUSE_S3_EVENT_UPLOAD_BUCKET=langfuse
LANGFUSE_S3_EVENT_UPLOAD_REGION=auto
LANGFUSE_S3_EVENT_UPLOAD_ENDPOINT=http://langfuse-minio:9000
LANGFUSE_S3_EVENT_UPLOAD_FORCE_PATH_STYLE=true
LANGFUSE_S3_EVENT_UPLOAD_PREFIX=events/
LANGFUSE_S3_MEDIA_UPLOAD_BUCKET=langfuse
LANGFUSE_S3_MEDIA_UPLOAD_REGION=auto
LANGFUSE_S3_MEDIA_UPLOAD_ENDPOINT=http://langfuse-minio:9000
LANGFUSE_S3_MEDIA_UPLOAD_INTERNAL_ENDPOINT=http://langfuse-minio:9000
LANGFUSE_S3_MEDIA_UPLOAD_FORCE_PATH_STYLE=true
LANGFUSE_S3_MEDIA_UPLOAD_PREFIX=media/
RUNTIME_STATE_DIRECTORY=/var/lib/local-llm
LITELLM_CONFIG_FILE=/opt/local-llm/runtime/litellm-config.yaml
