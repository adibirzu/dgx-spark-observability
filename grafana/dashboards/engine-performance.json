{"dashboard":{"title":"Local LLM Engine Performance","timezone":"browser","templating":{"list":[{"name":"node","type":"query","query":"label_values(up, instance)","includeAll":true},{"name":"interval","type":"interval","query":"15s,1m,5m"}]},"panels":[{"title":"Engine availability","type":"stat","targets":[{"expr":"llm_engine:up"}]},{"title":"vLLM running and waiting","type":"timeseries","targets":[{"expr":"vllm:num_requests_running"},{"expr":"vllm:num_requests_waiting"}]},{"title":"vLLM generation rate","type":"timeseries","targets":[{"expr":"rate(vllm:generation_tokens_total[5m])"}]},{"title":"vLLM request latency","type":"timeseries","targets":[{"expr":"histogram_quantile(0.95, sum by (le) (rate(vllm:e2e_request_latency_seconds_bucket[5m])))"}]},{"title":"vLLM KV cache","type":"gauge","targets":[{"expr":"vllm:kv_cache_usage_perc"}]},{"title":"llama.cpp throughput","type":"timeseries","targets":[{"expr":"llamacpp:prompt_tokens_seconds"},{"expr":"llamacpp:predicted_tokens_seconds"}]},{"title":"llama.cpp queue","type":"timeseries","targets":[{"expr":"llamacpp:requests_processing"},{"expr":"llamacpp:requests_deferred"}]},{"title":"Ollama state","type":"stat","targets":[{"expr":"ollama_state"},{"expr":"ollama_loaded_models"}]},{"title":"GPU utilization and memory","type":"timeseries","targets":[{"expr":"DCGM_FI_DEV_GPU_UTIL"},{"expr":"fleet:gpu_memory_pressure:ratio"}]},{"title":"GPU temperature and power","type":"timeseries","targets":[{"expr":"DCGM_FI_DEV_GPU_TEMP"},{"expr":"DCGM_FI_DEV_POWER_USAGE"}]},{"title":"No data or stale engine","type":"table","targets":[{"expr":"llm_engine:up == 0"}]}]}}
